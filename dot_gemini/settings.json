{
  "general": {
    "enableNotifications": true,
    "preferredEditor": "vscode"
  },
  "ide": {
    "enabled": true,
    "hasSeenNudge": true
  },
  "security": {
    "auth": {
      "selectedType": "gemini-api-key"
    },
    "disableYoloMode": true,
    "folderTrust": {
      "enabled": true
    }
  },
  "ui": {
    "customThemes": {
      // https://github.com/catppuccin/gemini-cli
      "Catppuccin Mocha": {
        "AccentBlue": "#89b4fa",
        "AccentCyan": "#94e2d5",
        "AccentGreen": "#a6e3a1",
        "AccentPurple": "#cba6f7",
        "AccentRed": "#f38ba8",
        "AccentYellow": "#f9e2af",
        "Background": "#1e1e2e",
        "Comment": "#9399b2",
        "DiffAdded": "#546d5c",
        "DiffRemoved": "#734a5f",
        "Foreground": "#cdd6f4",
        "GradientColors": [
          "#89b4fa",
          "#cba6f7",
          "#f38ba8"
        ],
        "Gray": "#7f849c",
        "LightBlue": "#89dceb",
        "name": "Catppuccin Mocha",
        "type": "custom"
      }
    },
    "footer": {
      "items": [
        "workspace",
        "git-branch",
        "model-name",
        "context-used",
        "quota",
        "memory-usage",
        "token-count"
      ]
    },
    "inlineThinkingMode": "full",
    "showCitations": true,
    "theme": "Catppuccin Mocha"
  }
}